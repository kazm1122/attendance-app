<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#06131f"><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet"><title>نظام الحضور الذكي</title>
<style>
:root{--bg:#06131f;--p:rgba(14,36,54,.72);--b:rgba(120,200,230,.16);--t:#eaf6fb;--m:#8fb0c2;--a:#2dd4bf;--a2:#38bdf8;--ok:#34d399;--wn:#fbbf24;--bd:#fb7185;font-family:"Segoe UI","Noto Sans Arabic","Noto Kufi Arabic",Tahoma,system-ui,sans-serif}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}html{scroll-padding-top:70px}
body{margin:0;background:var(--bg);color:var(--t);font-size:16px;line-height:1.6;min-height:100vh;padding:0 0 92px}
.bg{position:fixed;inset:0;z-index:-1;overflow:hidden;background:radial-gradient(120% 80% at 50% 0,#0b2a40,#06131f 70%)}
.bg i{position:absolute;border-radius:50%;filter:blur(70px);opacity:.38;animation:drift 22s ease-in-out infinite alternate}
.bg i:nth-child(1){width:340px;height:340px;background:#0ea5a4;top:-80px;right:-60px}
.bg i:nth-child(2){width:300px;height:300px;background:#2563eb;bottom:5%;left:-90px;animation-duration:28s}
.bg i:nth-child(3){width:220px;height:220px;background:#06b6d4;top:45%;right:30%;animation-duration:34s;opacity:.2}
.bg:after{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(120,200,230,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(120,200,230,.05) 1px,transparent 1px);background-size:38px 38px;-webkit-mask-image:radial-gradient(80% 60% at 50% 20%,#000,transparent);mask-image:radial-gradient(80% 60% at 50% 20%,#000,transparent)}
@keyframes drift{to{transform:translate(50px,60px) scale(1.15)}}
.top{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:12px;padding:calc(10px + env(safe-area-inset-top)) 16px 10px;background:rgba(6,19,31,.78);backdrop-filter:blur(14px);border-bottom:1px solid var(--b)}
.logo{width:42px;height:42px;flex:none}.top h1{font-size:18px;margin:0;font-weight:700;line-height:1.2}.top small{color:var(--m);font-size:12px}
.clock{margin-inline-start:auto;text-align:left;font-variant-numeric:tabular-nums;font-size:20px;font-weight:700;color:var(--a)}
main{max-width:760px;margin:auto;padding:14px}
.tab{display:none}.tab.on{display:block;animation:in .35s ease}@keyframes in{from{opacity:0;transform:translateY(8px)}}
.card{background:var(--p);border:1px solid var(--b);border-radius:20px;padding:18px;margin-bottom:14px;backdrop-filter:blur(10px);box-shadow:0 10px 30px rgba(0,0,0,.25)}
h2{font-size:17px;margin:0 0 14px;display:flex;align-items:center;gap:9px;font-weight:700}h2 svg{width:22px;height:22px;color:var(--a)}
.muted{color:var(--m);font-size:14px}
.win{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border-radius:99px;font-size:13px;font-weight:600;background:rgba(45,212,191,.12);color:var(--a);border:1px solid rgba(45,212,191,.3)}
.win:before{content:"";width:8px;height:8px;border-radius:50%;background:currentColor;animation:pulse 1.6s infinite}.win.off{color:var(--bd);background:rgba(251,113,133,.1);border-color:rgba(251,113,133,.3)}
@keyframes pulse{50%{opacity:.25;transform:scale(1.5)}}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:14px 0 10px}
.st{background:rgba(5,18,29,.6);border:1px solid var(--b);border-radius:14px;padding:11px 4px;text-align:center}.st b{display:block;font-size:26px;line-height:1.2;font-variant-numeric:tabular-nums}.st span{font-size:12px;color:var(--m)}
.bar{height:8px;border-radius:9px;background:rgba(255,255,255,.08);overflow:hidden;display:flex}.bar i{height:100%;transition:width .6s}
.cam{position:relative;aspect-ratio:4/3;border-radius:16px;overflow:hidden;background:#03090f;border:1px solid var(--b);display:grid;place-items:center}
.cam video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:none}.cam.on video{display:block}
.cam .ph{color:var(--m);text-align:center;font-size:14px}.cam.on .ph{display:none}.cam .ph svg{width:54px;height:54px;color:var(--a);animation:fl 3s ease-in-out infinite}
@keyframes fl{50%{transform:translateY(-6px)}}
.frm{position:absolute;inset:14%;display:none;pointer-events:none}.cam.on .frm{display:block}
.frm b{position:absolute;width:30px;height:30px;border:3px solid var(--a);border-radius:6px}.frm b:nth-child(1){top:0;right:0;border-left:0;border-bottom:0}.frm b:nth-child(2){top:0;left:0;border-right:0;border-bottom:0}.frm b:nth-child(3){bottom:0;right:0;border-left:0;border-top:0}.frm b:nth-child(4){bottom:0;left:0;border-right:0;border-top:0}
.frm u{position:absolute;left:4%;right:4%;height:2px;background:linear-gradient(90deg,transparent,var(--a),transparent);box-shadow:0 0 14px var(--a);animation:sw 2.2s ease-in-out infinite alternate}@keyframes sw{from{top:4%}to{top:94%}}
button,input,select{font:inherit}
.btn{border:0;border-radius:13px;padding:13px 16px;font-weight:700;cursor:pointer;background:linear-gradient(135deg,var(--a),var(--a2));color:#04202b;transition:transform .15s}.btn:active{transform:scale(.97)}
.btn.g{background:rgba(255,255,255,.07);color:var(--t);border:1px solid var(--b)}.btn.r{background:rgba(251,113,133,.14);color:var(--bd);border:1px solid rgba(251,113,133,.35)}.btn.s{padding:8px 12px;font-size:13px}
.row{display:flex;gap:8px;margin-top:10px}.row>*{flex:1}
input,select{width:100%;padding:13px 14px;border-radius:12px;border:1px solid var(--b);background:rgba(3,12,20,.65);color:var(--t);font-size:16px;margin-top:6px}input:focus,select:focus{outline:2px solid var(--a);outline-offset:1px}
label{font-size:13px;color:var(--m);display:block;margin-top:10px}
.fb{margin-top:10px;padding:12px 14px;border-radius:12px;font-size:15px;font-weight:600;background:rgba(255,255,255,.05);border:1px solid var(--b);animation:in .3s}.fb.ok{background:rgba(52,211,153,.13);color:var(--ok);border-color:rgba(52,211,153,.4)}.fb.warn{background:rgba(251,191,36,.12);color:var(--wn);border-color:rgba(251,191,36,.4)}.fb.err{background:rgba(251,113,133,.12);color:var(--bd);border-color:rgba(251,113,133,.4)}
.chips{display:flex;gap:6px;overflow:auto;padding-bottom:6px;margin-bottom:6px}.chip{flex:none;padding:7px 14px;border-radius:99px;border:1px solid var(--b);background:transparent;color:var(--m);font-size:14px;cursor:pointer}.chip.on{background:var(--a);color:#04202b;border-color:var(--a);font-weight:700}
.it{display:flex;align-items:center;gap:12px;padding:12px 4px;border-bottom:1px solid var(--b);cursor:pointer}.it:last-child{border:0}
.av{width:42px;height:42px;border-radius:13px;display:grid;place-items:center;font-weight:700;background:rgba(45,212,191,.13);color:var(--a);flex:none}
.it .n{font-weight:600}.it small{color:var(--m);display:block;font-size:13px}.it .tm{margin-inline-start:auto;text-align:left}
.pl{font-size:12.5px;padding:4px 11px;border-radius:99px;font-weight:700;display:inline-block}.pl.present{background:rgba(52,211,153,.15);color:var(--ok)}.pl.late{background:rgba(251,191,36,.15);color:var(--wn)}.pl.absent{background:rgba(251,113,133,.15);color:var(--bd)}.pl.wait{background:rgba(143,176,194,.15);color:var(--m)}
.empty{text-align:center;color:var(--m);padding:26px 8px}
nav{position:fixed;bottom:0;inset-inline:0;z-index:30;display:flex;justify-content:center;gap:4px;padding:8px 10px calc(8px + env(safe-area-inset-bottom));background:rgba(6,19,31,.9);backdrop-filter:blur(16px);border-top:1px solid var(--b)}
nav button{flex:1;max-width:150px;background:none;border:0;color:var(--m);padding:6px 2px;font-size:12px;display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer;border-radius:12px}nav svg{width:25px;height:25px}nav button.on{color:var(--a);background:rgba(45,212,191,.1)}nav button.on svg{animation:pop 1.8s ease-in-out infinite}@keyframes pop{50%{transform:translateY(-3px) scale(1.1)}}
.ov{position:fixed;inset:0;z-index:50;background:rgba(2,8,14,.7);backdrop-filter:blur(5px);display:flex;align-items:flex-end;justify-content:center;animation:in .2s}
.sh{width:100%;max-width:520px;background:#0b2234;border:1px solid var(--b);border-radius:22px 22px 0 0;padding:20px 18px calc(20px + env(safe-area-inset-bottom));max-height:90vh;overflow:auto}.sh h3{margin:0 0 6px}
.id-card{background:linear-gradient(135deg,#0b3b4f,#0a2236);border:1px solid var(--b);border-radius:16px;padding:14px;display:flex;gap:14px;align-items:center;margin:12px 0}.id-card svg{width:108px;height:108px;border-radius:8px;flex:none}.id-card b{font-size:18px}
#print{display:none}
@media print{body>*:not(#print){display:none!important}#print{display:grid;grid-template-columns:repeat(2,1fr);gap:8mm;padding:8mm}.pc{border:1.5px solid #123;border-radius:10px;padding:10px;display:flex;gap:10px;align-items:center;color:#000;background:#fff;break-inside:avoid}.pc svg{width:34mm;height:34mm}.pc b{font-size:15pt;display:block}.pc span{font-size:11pt}}
@media(max-width:380px){.stats{grid-template-columns:repeat(2,1fr)}}
@media(prefers-reduced-motion:reduce){*{animation:none!important}}
.sp{position:fixed;inset:0;z-index:80;background:radial-gradient(120% 80% at 50% 0,#0b2a40,#06131f 70%);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:calc(20px + env(safe-area-inset-top)) 16px 20px;overflow:auto;text-align:center}.sp.h{display:none}.sp .card{width:100%;max-width:420px;margin:0}
.big{font-size:52px;font-weight:800;font-variant-numeric:tabular-nums;color:var(--a);direction:ltr;line-height:1.1}
.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.g3 label{margin-top:0;text-align:center}.g3 input{padding:10px 4px;text-align:center}
.mi{width:100%;text-align:right;margin-top:8px;display:block}

/* ===== Pro theme ===== */
:root{--bg:#050d16;--p:linear-gradient(160deg,rgba(19,40,62,.86),rgba(9,22,37,.88));--b:rgba(140,210,235,.14);font-family:"IBM Plex Sans Arabic","Segoe UI","Noto Sans Arabic",Tahoma,system-ui,sans-serif}
body{padding-bottom:104px}
.bg,.sp{background:radial-gradient(80% 55% at 85% -10%,#0f4660 0,transparent 62%),radial-gradient(70% 50% at 0 100%,#0a2c5e 0,transparent 62%),#050d16}
.bg i{opacity:.22}
.top{background:rgba(5,13,22,.74);border-bottom:1px solid var(--b)}
.top h1{letter-spacing:.2px}
.clock{background:rgba(45,212,191,.1);border:1px solid rgba(45,212,191,.25);padding:3px 12px;border-radius:12px;font-size:18px}
.card{border-radius:22px;box-shadow:0 1px 0 rgba(255,255,255,.06) inset,0 22px 44px -22px rgba(0,0,0,.7)}
h2:before{content:"";width:4px;height:18px;border-radius:4px;background:linear-gradient(var(--a),var(--a2));flex:none}
.st{background:rgba(4,14,24,.55);border-radius:16px}.st b{font-weight:700}
.btn{border-radius:14px;box-shadow:0 10px 22px -10px rgba(45,212,191,.7)}.btn.g,.btn.r{box-shadow:none}
input,select{background:rgba(3,11,19,.7)}
.it{border-radius:12px;transition:background .15s}.it:active{background:rgba(255,255,255,.04)}
nav{inset-inline:12px;bottom:calc(10px + env(safe-area-inset-bottom));padding:6px;max-width:520px;margin-inline:auto;border-radius:22px;border:1px solid var(--b);background:rgba(8,22,36,.9);box-shadow:0 18px 40px -10px rgba(0,0,0,.8)}
nav button.on{background:linear-gradient(135deg,rgba(45,212,191,.2),rgba(56,189,248,.14))}
.sp .big{background:linear-gradient(180deg,#fff,#7fe9dc);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;filter:drop-shadow(0 0 18px rgba(45,212,191,.35))}
.pb{height:6px;border-radius:9px;background:rgba(255,255,255,.08);overflow:hidden;margin-top:14px}.pb i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--a),var(--a2));transition:width 1s linear}
</style><style>
#tmCard.fin{border-color:rgba(251,113,133,.55)}
#tmCard.fin .big{background:none;-webkit-text-fill-color:var(--bd);color:var(--bd);filter:none}
#tmPill{position:fixed;top:calc(8px + env(safe-area-inset-top));left:50%;transform:translateX(-50%);z-index:60;padding:6px 14px;border-radius:99px;font-size:14px;font-weight:700;direction:ltr;background:rgba(6,19,31,.88);color:var(--a);border:1px solid rgba(45,212,191,.4);pointer-events:none;font-variant-numeric:tabular-nums}
#tmPill.fin{color:var(--bd);border-color:rgba(251,113,133,.5)}
</style>
</head><body>
<div class="bg"><i></i><i></i><i></i></div>
<header class="top"><button class="btn g s" onclick="openMenu()" aria-label="القائمة" style="padding:9px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button><svg class="logo" viewBox="0 0 48 48" fill="none" stroke="#2dd4bf" stroke-width="3" stroke-linecap="round"><path d="M8 17V10a2 2 0 012-2h7M31 8h7a2 2 0 012 2v7M40 31v7a2 2 0 01-2 2h-7M17 40h-7a2 2 0 01-2-2v-7"/><rect x="15" y="15" width="7" height="7" rx="1.5"/><rect x="26" y="15" width="7" height="7" rx="1.5"/><rect x="15" y="26" width="7" height="7" rx="1.5"/><path d="M29 29h4v4" stroke-width="2.5"/><path d="M10 24h28" stroke="#38bdf8" stroke-width="2.5"><animate attributeName="d" values="M10 13h28;M10 35h28;M10 13h28" dur="3.2s" repeatCount="indefinite"/></path></svg><div><h1>نظام الحضور الذكي</h1><small id="dayLbl"></small></div><div class="clock" id="clock">--:--</div></header>
<main>
<section class="tab on" id="t-home">
<div class="card"><h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>تقرير اليوم</h2><span class="win" id="win"></span>
<div class="stats"><div class="st"><b id="sP" style="color:var(--ok)">0</b><span>حاضر</span></div><div class="st"><b id="sL" style="color:var(--wn)">0</b><span>متأخر</span></div><div class="st"><b id="sA" style="color:var(--bd)">0</b><span>غائب</span></div><div class="st"><b id="sT">0</b><span>المجموع</span></div></div><div class="bar" id="bar"></div></div>
<div class="card"><h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 8V5a1 1 0 011-1h3M16 4h3a1 1 0 011 1v3M20 16v3a1 1 0 01-1 1h-3M8 20H5a1 1 0 01-1-1v-3M4 12h16"/></svg>مسح البطاقات</h2>
<div class="cam" id="cam"><video id="vid" playsinline muted></video><div class="ph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h2l1.5-2h9L18 8h2a1 1 0 011 1v9a1 1 0 01-1 1H4a1 1 0 01-1-1V9a1 1 0 011-1z"/><circle cx="12" cy="13" r="3.5"/></svg><br>الكاميرا متوقفة</div><div class="frm"><b></b><b></b><b></b><b></b><u></u></div></div>
<div class="row"><button class="btn" onclick="startCam()">تشغيل الكاميرا</button><button class="btn g" onclick="stopCam()">إيقاف</button></div>
<div class="fb" id="fb">وجّه بطاقة الطالب نحو الكاميرا</div>
<label>أو سجّل بالرقم التعريفي (احتياطي)</label><div class="row" style="margin-top:6px"><input id="man" placeholder="الرقم التعريفي" inputmode="text" style="margin:0" onkeydown="if(event.key=='Enter')manual()"><button class="btn g" style="flex:none" onclick="manual()">تسجيل</button></div></div>
<div class="card"><h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01"/></svg>سجل اليوم</h2><div class="chips" id="chips"></div><div id="list"></div></div>
</section>
<section class="tab" id="t-stu">
<div class="card"><h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>إضافة طالب</h2><label>اسم الطالب</label><input id="nm" placeholder="الاسم الثلاثي"><label>الصف والشعبة</label><input id="cl" placeholder="مثال: الثالث - ب"><label>الرقم التعريفي (أرقام أو حروف إنكليزية)</label><input id="sid" placeholder="مثال: 1024" inputmode="text" dir="ltr" style="text-align:right"><button class="btn" style="width:100%;margin-top:14px" onclick="addS()">حفظ وإنشاء البطاقة</button></div>
<div class="card"><h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0113 0M16 4.5a3.5 3.5 0 010 7M18 14.5a6 6 0 013.5 5.5"/></svg>الطلاب (<span id="cnt">0</span>)</h2><div id="slist"></div><button class="btn g" style="width:100%;margin-top:12px" onclick="printCards()">طباعة كل البطاقات</button></div>
</section>
<section class="tab" id="t-arc">
<div class="card"><h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="5" rx="1"/><path d="M5 9v10h14V9M10 13h4"/></svg>أرشيف الأيام</h2><select id="arcSel" onchange="arc=this.value;render()"></select><div class="stats"><div class="st"><b id="aP" style="color:var(--ok)">0</b><span>حاضر</span></div><div class="st"><b id="aL" style="color:var(--wn)">0</b><span>متأخر</span></div><div class="st"><b id="aA" style="color:var(--bd)">0</b><span>غائب</span></div><div class="st"><b id="aT">0</b><span>المجموع</span></div></div><div id="alist"></div><button class="btn g" style="width:100%;margin-top:12px" onclick="exportCSV()">تصدير هذا اليوم (Excel)</button></div>
</section>
<section class="tab" id="t-set">
<div class="card"><h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>أوقات التسجيل</h2><label>بداية التسجيل</label><input type="time" id="cs" onchange="cfg()"><label>اعتبار الطالب متأخراً بعد</label><input type="time" id="cL" onchange="cfg()"><label>نهاية التسجيل (بعدها يُحسب الغائبون تلقائياً)</label><input type="time" id="ce" onchange="cfg()"></div>
<div class="card"><h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 109-9 9 9 0 00-6.4 2.6L3 8M3 3v5h5"/></svg>يوم جديد</h2><p class="muted" style="margin-top:0">يبدأ كل يوم بقائمة نظيفة تلقائياً، والأيام السابقة تُحفظ في الأرشيف. استخدم الزر لتصفير قائمة اليوم الحالي فقط.</p><button class="btn r" style="width:100%" onclick="resetToday()">تصفير قائمة اليوم</button></div>
<div class="card"><h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>الخصوصية</h2><p class="muted" style="margin:0">كل البيانات محفوظة داخل هذا الهاتف فقط ولا تُرسل لأي جهة. النظام لا يستخدم صور الوجوه.</p></div>
<div class="card"><h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h2l1.5-2h9L18 8h2a1 1 0 011 1v9a1 1 0 01-1 1H4a1 1 0 01-1-1V9a1 1 0 011-1z"/><circle cx="12" cy="13" r="3.5"/></svg>إذن الكاميرا</h2><p class="muted" style="margin-top:0" id="camSt"></p><button class="btn" style="width:100%" onclick="go('home');startCam()">طلب الإذن وتشغيل الكاميرا</button></div>
<div class="card"><h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 10l5 5 5-5M4 20h16"/></svg>نسخة احتياطية</h2><p class="muted" style="margin-top:0">البيانات تُحفظ تلقائياً في المتصفح، لكنها تُحذف إذا مسحت بيانات المتصفح أو غيّرت الرابط. صدّر نسخة بين فترة وأخرى واحتفظ بها.</p><div class="row"><button class="btn" onclick="exportJSON()">حفظ نسخة</button><button class="btn g" onclick="$('imp').click()">استرجاع نسخة</button></div><input type="file" id="imp" accept=".json,application/json" hidden onchange="importJSON(this)"></div>
</section>
</main>
<nav id="nav"><button class="on" data-t="home"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 8V5a1 1 0 011-1h3M16 4h3a1 1 0 011 1v3M20 16v3a1 1 0 01-1 1h-3M8 20H5a1 1 0 01-1-1v-3M4 12h16"/></svg>الحضور</button><button data-t="stu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0113 0M16 4.5a3.5 3.5 0 010 7M18 14.5a6 6 0 013.5 5.5"/></svg>الطلاب</button><button data-t="arc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="5" rx="1"/><path d="M5 9v10h14V9M10 13h4"/></svg>الأرشيف</button><button data-t="set"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/></svg>الإعدادات</button></nav>
<div class="sp" id="splash"><h1 style="margin:0;font-size:22px">نظام الحضور الذكي</h1><div class="muted" id="spDay"></div><div class="big" id="spNow">--:--:--</div>
<div class="card"><span class="win" id="spWin"></span><div class="muted" id="spLbl" style="margin-top:12px"></div><div class="big" id="spCnt" style="font-size:42px">--:--:--</div><div class="pb"><i id="spBar"></i></div></div>
<div class="card" id="tmCard"><h2 style="justify-content:center">⏱ مؤقّت الدوام</h2><div class="muted" id="tmLbl">لم يبدأ المؤقّت</div><div class="big" id="tmCnt" style="font-size:42px">--:--:--</div><div class="pb"><i id="tmBar"></i></div><div id="tmSet"><div class="row"><div><label>ساعات</label><input type="number" id="tmH" min="0" max="99" inputmode="numeric" value="4"></div><div><label>دقائق</label><input type="number" id="tmM" min="0" max="59" inputmode="numeric" value="0"></div></div><button class="btn" style="width:100%;margin-top:10px" onclick="tmStart()">▶ ابدأ المؤقّت</button><div class="fb err" id="tmErr" hidden>حدّد مدة أكبر من صفر</div></div><button class="btn r" id="tmStop" style="width:100%;margin-top:10px" hidden onclick="tmStop()">إيقاف المؤقّت</button></div>
<div class="fb err" id="spSec" hidden style="max-width:420px">الكاميرا لن تعمل لأن الموقع مفتوح بدون اتصال آمن (لا يوجد قفل 🔒). ارفعه على رابط https.</div>
<div class="card"><h2 style="justify-content:center">حدّد وقت الدوام</h2><div class="g3"><div><label>البداية</label><input type="time" id="sS" onchange="spCfg()"></div><div><label>التأخير بعد</label><input type="time" id="sL" onchange="spCfg()"></div><div><label>النهاية</label><input type="time" id="sE" onchange="spCfg()"></div></div><div class="fb err" id="spErr" hidden>الترتيب غير صحيح: البداية ثم التأخير ثم النهاية</div></div>
<div class="card" style="background:none;border:0;box-shadow:none;padding:0"><button class="btn" style="width:100%" onclick="enter(1)">دخول وتشغيل الكاميرا</button><button class="btn g" style="width:100%;margin-top:8px" onclick="enter(0)">دخول بدون كاميرا</button></div></div>
<div id="tmPill" hidden></div>
<div id="print"></div>
